<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/numTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="40dp"
            android:text="ادخل رقم المستفيد:"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/pickContactBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="اختر من جهات الاتصال"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/contacts"
            app:layout_constraintBottom_toBottomOf="@id/numTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/numTv"
            app:tint="?attr/colorControlNormal" />

        <EditText
            android:id="@+id/numEt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_rounded_bg"
            android:hint="ادخل رقم الهاتف هنا"
            android:inputType="number"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pickContactBtn" />

        <TextView
            android:id="@+id/priceTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="25dp"
            android:text="ادخل المبلغ المراد تحويله:"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/numEt" />

        <EditText
            android:id="@+id/priceEt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_rounded_bg"
            android:hint="ادخل المبلغ هنا"
            android:inputType="number"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/priceTv" />

        <RadioGroup
            android:id="@+id/typeRg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/priceEt">

            <RadioButton
                android:id="@+id/freindPayRb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الدفع لصديق"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/traderPayRb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الدفع لتاجر"
                android:textSize="20sp" />

        </RadioGroup>

        <Button
            android:id="@+id/callJawwalBt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="30dp"
            android:text="جوال بي"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@drawable/jawwal"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:background="@drawable/rounded_buttons"
            app:backgroundTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/callPalpayBt"
            app:layout_constraintTop_toBottomOf="@id/typeRg" />

        <Button
            android:id="@+id/callPalpayBt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="15dp"
            android:text="بال باي"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:icon="@drawable/palpay"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            android:background="@drawable/rounded_button2"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/callJawwalBt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/callJawwalBt"
            app:layout_constraintBottom_toBottomOf="@id/callJawwalBt" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>